{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "dockerfile": "Dockerfile",
  "framework": null,
  "env": {
    "PYTHONUNBUFFERED": "1",
    "PORT": "8000",
    "PYTHONPATH": "/app",
    "DATABASE_URL": "@DATABASE_URL",
    "JWT_SECRET": "@JWT_SECRET",
    "SECRET_KEY": "@SECRET_KEY",
    "DJANGO_SETTINGS_MODULE": "config.settings",
    "CORS_ALLOW_ALL_ORIGINS": "true"
  }
}
