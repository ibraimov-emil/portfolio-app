{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "dockerfile": "Dockerfile",
  "source": "docker",
  "framework": null,
  "regions": ["iad1"],
  "installCommand": "pip install -r requirements.txt gunicorn",
  "buildCommand": "python manage.py collectstatic --noinput && python manage.py migrate",
  "devCommand": "python manage.py runserver 0.0.0.0:8000",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "PORT": "8000",
    "PYTHONPATH": "/app",
    "DATABASE_URL": "@DATABASE_URL",
    "JWT_SECRET": "@JWT_SECRET",
    "SECRET_KEY": "@SECRET_KEY",
    "DJANGO_SETTINGS_MODULE": "config.settings",
    "CORS_ALLOW_ALL_ORIGINS": "true",
    "STORAGE_BACKEND": "@STORAGE_BACKEND",
    "STORAGE_LOCATION": "@STORAGE_LOCATION",
    "AWS_ACCESS_KEY_ID": "@AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY": "@AWS_SECRET_ACCESS_KEY",
    "NEXT_PUBLIC_API_URL": "@NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_STRAPI_URL": "@NEXT_PUBLIC_STRAPI_URL",
    "NEXT_PUBLIC_PYTHON_API_URL": "@NEXT_PUBLIC_PYTHON_API_URL"
  }
}
